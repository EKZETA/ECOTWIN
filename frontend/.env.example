# ============================================================
# EcoTwin Frontend Configuration
# Rename this file to .env before running the dev server
# ============================================================

# ------ Backend Connection ------
# Point these to wherever the FastAPI backend is running.
# If your teammate changed APP_PORT in backend/.env, update the port here too.
VITE_BACKEND_HOST=127.0.0.1
VITE_BACKEND_PORT=8000

# These are derived automatically — no need to change unless using HTTPS/WSS.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws/telemetry