# ============================================================
# EcoTwin Backend Configuration
# Rename this file to .env before running the server
# ============================================================

# ------ Server ------
# Host and port for the FastAPI/Uvicorn server.
# Change these if port 8000 is occupied on your machine.
APP_HOST=127.0.0.1
APP_PORT=8000

# ------ SUMO ------
# Full path to your SUMO installation directory.
# Windows default: C:\Program Files (x86)\Eclipse\Sumo
# Linux/macOS: /usr/share/sumo  or  /opt/homebrew/opt/sumo/share/sumo
SUMO_HOME=C:\Program Files (x86)\Eclipse\Sumo

# Absolute paths to the simulation config and road network files.
# Replace "D:\path\to\your\repo" with the actual path on your machine.
SIMULATION_PATH=D:\path\to\your\repo\ECOTWIN\simulation\configs\simulation.sumocfg
NETWORK_PATH=D:\path\to\your\repo\ECOTWIN\simulation\networks\city_grid.net.xml