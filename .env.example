# ==============================================================================
# EcoTwin - Environment Configuration Template (.env.example)
# ==============================================================================

# Eclipse SUMO Installation Directory
SUMO_HOME=C:\Program Files (x86)\Eclipse\Sumo

# SUMO Display Mode: true for GUI window (sumo-gui.exe), false for headless (sumo.exe)
SUMO_GUI=true

# Relative or absolute paths to SUMO config and network files
SIMULATION_PATH=simulation/configs/simulation.sumocfg
NETWORK_PATH=simulation/networks/city_grid.net.xml

# Backend Simulation Configuration
SIM_FPS=10

# Reinforcement learning checkpoint and simulation steps per policy decision
RL_MODEL_PATH=models/ecotwin_ppo_tune_lr1e4
RL_DECISION_INTERVAL_STEPS=10

# Ray object-store allocation in MiB (minimum 80; increase if system memory allows)
RAY_OBJECT_STORE_MEMORY_MB=80
