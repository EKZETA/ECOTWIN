# ============================================================
# EcoTwin Frontend Configuration
# Rename this file to .env before running the dev server
# ============================================================

# Backend target for the Vite development proxy.
VITE_BACKEND_HOST=127.0.0.1
VITE_BACKEND_PORT=8000

# Set these only when the frontend is hosted separately from the backend.
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_WS_URL=ws://127.0.0.1:8000/ws/telemetry
